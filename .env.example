# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Your production URL — used to generate correct Open Graph/social preview
# image URLs and canonical links. Defaults to localhost if unset.
SITE_URL=https://www.cloudedgetech.com

# Required for newsletter signup notifications (sent to chohanv828@gmail.com).
# 1. Sign up at https://resend.com (free tier is enough to start).
# 2. Create an API key: https://resend.com/api-keys
# 3. Paste it below.
RESEND_API_KEY=

# Optional — the "from" address notification emails are sent from.
# Resend's shared "onboarding@resend.dev" works out of the box for testing,
# but for production you should verify your own domain in Resend and use
# an address on it instead, e.g. "CloudEdge Website <notify@cloudedgetech.com>".
RESEND_FROM="CloudEdge Website <onboarding@resend.dev>"

# Required to log into /admin (view contact/booking/newsletter/application
# submissions). Pick your own strong password — this is the only thing
# gating access to that data.
ADMIN_PASSWORD=

# Optional — separate signing secret for the admin session cookie. Falls
# back to ADMIN_PASSWORD if unset, which is fine for a single-admin tool.
ADMIN_SESSION_SECRET=
